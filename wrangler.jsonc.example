{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tailscale-server-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "ADMIN_USER_ID": "YOUR_TELEGRAM_USER_ID",
    "OFFLINE_AFTER": "2",
    "BOT_LANGUAGE": "zh",
    "TIME_ZONE": "UTC",
    "BOT_TITLE": "",
    "HIDDEN_TAGS": "",
    "GEOIP_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "STATUS_DB",
      "database_name": "tailscale-server-monitor",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "StatusScheduler" }]
  },
  "migrations": [{ "tag": "scheduler-v1", "new_sqlite_classes": ["StatusScheduler"] }],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
